# Python
__pycache__/
*.pyc
venv/
.venv/
.ipynb_checkpoints/

# Secrets — never commit passwords or tokens
.env
*.env
config.ini

# Raw dataset (large; downloaded from Kaggle — see data/raw/README.md)
data/raw/*.csv
data/raw/*.zip

# Cleaned data is generated by notebooks/02_data_cleaning_eda.ipynb
data/cleaned/*.csv

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
~$*

# Excel export for Power BI web (generated by scripts/export_for_powerbi.py)
data/powerbi/*.xlsx

# LibreOffice lock files (created while a file is open)
.~lock.*
